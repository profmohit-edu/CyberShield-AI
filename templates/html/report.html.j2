<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>CyberShield AI Security Report — {{ source_name }}</title>
  <style>
    :root { --ink:#0f172a; --muted:#64748b; --line:#dbe3ee; --surface:#f8fafc; --brand:#0284c7; --brand-dark:#075985; }
    * { box-sizing:border-box; }
    body { margin:0; color:var(--ink); background:#eef3f8; font:15px/1.6 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    .shell { width:min(1180px,calc(100% - 32px)); margin:32px auto 64px; }
    .hero { position:relative; overflow:hidden; padding:48px; border-radius:24px; color:white; background:linear-gradient(135deg,#07172d,#0c4a6e 58%,#0ea5e9); box-shadow:0 24px 60px rgba(15,23,42,.18); }
    .hero::after { content:""; position:absolute; width:300px; height:300px; right:-80px; top:-150px; border:1px solid rgba(255,255,255,.18); border-radius:50%; box-shadow:0 0 0 42px rgba(255,255,255,.04),0 0 0 86px rgba(255,255,255,.03); }
    .eyebrow { margin:0 0 8px; color:#7dd3fc; font-size:12px; font-weight:800; letter-spacing:.16em; text-transform:uppercase; }
    h1 { max-width:760px; margin:0; font-size:clamp(30px,5vw,52px); line-height:1.08; letter-spacing:-.035em; }
    .contract { margin:16px 0 28px; color:#dbeafe; font-size:18px; }
    .meta { display:flex; flex-wrap:wrap; gap:12px 28px; color:#e0f2fe; font-size:13px; }
    .grid { display:grid; grid-template-columns:repeat(12,1fr); gap:20px; margin-top:20px; }
    .card { padding:24px; border:1px solid var(--line); border-radius:18px; background:white; box-shadow:0 8px 24px rgba(15,23,42,.05); }
    .metric { grid-column:span 3; }
    .metric strong { display:block; font-size:32px; line-height:1.2; letter-spacing:-.03em; }
    .metric span,.label { color:var(--muted); font-size:12px; font-weight:750; letter-spacing:.08em; text-transform:uppercase; }
    .wide { grid-column:span 12; }
    .half { grid-column:span 6; }
    h2 { margin:0 0 18px; font-size:22px; letter-spacing:-.02em; }
    h3 { margin:0; font-size:18px; }
    table { width:100%; border-collapse:collapse; font-size:13px; }
    th,td { padding:12px 10px; border-bottom:1px solid var(--line); text-align:left; vertical-align:top; }
    th { color:var(--muted); font-size:11px; letter-spacing:.06em; text-transform:uppercase; }
    .severity-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:10px; }
    .severity-box { padding:15px; border-radius:12px; color:white; }
    .severity-box strong { display:block; font-size:25px; }
    .severity-box span { font-size:11px; font-weight:800; letter-spacing:.05em; text-transform:uppercase; }
    .pill { display:inline-flex; align-items:center; padding:3px 9px; border-radius:999px; color:white; font-size:11px; font-weight:800; text-transform:uppercase; }
    .status { font-weight:750; }
    .status-succeeded { color:#047857; } .status-failed { color:#b91c1c; } .status-disabled { color:#64748b; }
    details.finding { margin:14px 0; border:1px solid var(--line); border-radius:16px; background:white; overflow:hidden; }
    details.finding[open] { box-shadow:0 12px 32px rgba(15,23,42,.07); }
    summary { display:grid; grid-template-columns:1fr auto; gap:16px; align-items:center; padding:20px 22px; cursor:pointer; list-style:none; }
    summary::-webkit-details-marker { display:none; }
    .finding-head { display:flex; align-items:center; gap:12px; }
    .finding-number { display:grid; width:34px; height:34px; place-items:center; border-radius:10px; color:var(--brand-dark); background:#e0f2fe; font-weight:850; }
    .finding-body { padding:0 22px 24px; border-top:1px solid var(--line); }
    .fact-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin:18px 0; }
    .fact { padding:12px; border-radius:10px; background:var(--surface); }
    .fact b { display:block; margin-top:3px; overflow-wrap:anywhere; }
    .evidence { margin-top:10px; padding:14px; border-left:3px solid #38bdf8; background:#f0f9ff; border-radius:0 10px 10px 0; }
    pre { overflow:auto; margin:14px 0 0; padding:18px; border-radius:12px; color:#e2e8f0; background:#07111f; font:12px/1.65 "SFMono-Regular",Consolas,monospace; tab-size:2; }
    .tok-keyword { color:#7dd3fc; font-weight:700; } .tok-string { color:#bef264; } .tok-number { color:#fda4af; } .tok-comment { color:#94a3b8; font-style:italic; }
    .recommendations { margin:0; padding-left:20px; } .recommendations li { margin:10px 0; padding-left:5px; }
    footer { margin-top:24px; color:var(--muted); text-align:center; font-size:12px; }
    @media (max-width:850px) { .metric,.half { grid-column:span 6; } .fact-grid { grid-template-columns:repeat(2,1fr); } .severity-grid { grid-template-columns:repeat(2,1fr); } .hero { padding:34px 26px; } }
    @media (max-width:560px) { .shell { width:min(100% - 20px,1180px); margin-top:10px; } .metric,.half { grid-column:span 12; } .fact-grid { grid-template-columns:1fr; } summary { grid-template-columns:1fr; } .card { padding:18px; } }
    @media print { body { background:white; } .shell { width:100%; margin:0; } .hero,.card,details.finding { box-shadow:none; } details.finding > .finding-body { display:block; } }
  </style>
</head>
<body>
  <main class="shell">
    <header class="hero">
      <p class="eyebrow">CyberShield AI · Security Intelligence</p>
      <h1>Smart Contract Security Report</h1>
      <p class="contract">{{ source_name }}</p>
      <div class="meta">
        <span>Generated {{ report.generated_at }}</span>
        <span>Version {{ report.version }}</span>
        <span>SHA-256 {{ report.source_sha256[:16] }}…</span>
      </div>
    </header>

    <section class="grid" aria-label="Executive summary">
      <article class="card metric"><strong>{{ summary.vulnerability_count }}</strong><span>Canonical vulnerabilities</span></article>
      <article class="card metric"><strong>{{ summary.source_finding_count }}</strong><span>Analyzer findings</span></article>
      <article class="card metric"><strong>{{ analyzers|selectattr('status','equalto','succeeded')|list|length }}</strong><span>Analyzers succeeded</span></article>
      <article class="card metric"><strong>{{ '%.2f'|format(execution.total_execution_time_ms) }}</strong><span>Total runtime (ms)</span></article>

      <article class="card half">
        <h2>Severity summary</h2>
        <div class="severity-grid">
          {% for severity in severity_order %}
          <div class="severity-box" style="background:{{ severity_colors[severity] }}">
            <strong>{{ summary.severity_counts[severity] }}</strong><span>{{ severity }}</span>
          </div>
          {% endfor %}
        </div>
      </article>

      <article class="card half">
        <h2>Assessment context</h2>
        <p>The orchestrator correlated normalized evidence from {{ analyzers|length }} registered analyzers. Confidence measures agreement across tools, severity, and source location; it does not replace exploitability review.</p>
        <p><span class="label">Orchestrator runtime</span><br><b>{{ '%.2f'|format(execution.orchestrator_execution_time_ms) }} ms</b></p>
      </article>

      <article class="card wide">
        <h2>Consensus table</h2>
        <div style="overflow:auto">
          <table>
            <thead><tr><th>#</th><th>Finding</th><th>Severity</th><th>Confidence</th><th>Analyzers</th><th>Location</th></tr></thead>
            <tbody>
              {% for finding in findings %}
              <tr>
                <td>{{ finding.number }}</td><td><a href="#{{ finding.anchor }}">{{ finding.title }}</a></td>
                <td><span class="pill" style="background:{{ severity_colors[finding.severity] }}">{{ finding.severity }}</span></td>
                <td>{{ finding.confidence_percent }}</td><td>{{ finding.contributing_analyzers|join(', ') }}</td><td>{{ finding.location }}</td>
              </tr>
              {% else %}<tr><td colspan="6">No canonical vulnerabilities were reported.</td></tr>{% endfor %}
            </tbody>
          </table>
        </div>
      </article>

      <article class="card wide">
        <h2>Analyzer comparison</h2>
        <div style="overflow:auto">
          <table>
            <thead><tr><th>Analyzer</th><th>Status</th><th>Runtime</th><th>Findings</th><th>Error</th></tr></thead>
            <tbody>{% for analyzer in analyzers %}<tr>
              <td><b>{{ analyzer.analyzer }}</b></td><td class="status status-{{ analyzer.status }}">{{ analyzer.status }}</td>
              <td>{{ '%.2f'|format(analyzer.execution_time_ms) }} ms</td><td>{{ analyzer.finding_count }}</td>
              <td>{{ analyzer.error.message if analyzer.error else '—' }}</td>
            </tr>{% endfor %}</tbody>
          </table>
        </div>
      </article>
    </section>

    <section style="margin-top:28px" aria-labelledby="details-heading">
      <h2 id="details-heading">Detailed findings</h2>
      {% for finding in findings %}
      <details class="finding" id="{{ finding.anchor }}"{% if loop.first %} open{% endif %}>
        <summary>
          <div class="finding-head"><span class="finding-number">{{ finding.number }}</span><h3>{{ finding.title }}</h3></div>
          <span class="pill" style="background:{{ severity_colors[finding.severity] }}">{{ finding.severity }}</span>
        </summary>
        <div class="finding-body">
          <div class="fact-grid">
            <div class="fact"><span class="label">Confidence</span><b>{{ finding.confidence_percent }}</b></div>
            <div class="fact"><span class="label">Location</span><b>{{ finding.location }}</b></div>
            <div class="fact"><span class="label">Analyzers</span><b>{{ finding.contributing_analyzers|join(', ') }}</b></div>
            <div class="fact"><span class="label">Rules</span><b>{{ finding.rule_ids|join(', ') }}</b></div>
          </div>
          {% for description in finding.descriptions %}<p>{{ description }}</p>{% endfor %}
          <h3>Supporting evidence</h3>
          {% for support in finding.supporting_findings %}
          <div class="evidence"><b>{{ support.analyzer }} · {{ support.rule_id }} · {{ support.severity }}</b><br>{{ support.description }}<br><small>{{ support.location }}</small></div>
          {% endfor %}
          {% if finding.snippet.source %}
          <h3 style="margin-top:18px">Source evidence · lines {{ finding.snippet.start_line }}–{{ finding.snippet.end_line }}</h3>
          <pre><code class="language-solidity">{{ finding.highlighted_snippet }}</code></pre>
          {% endif %}
        </div>
      </details>
      {% else %}<div class="card">No canonical vulnerabilities were reported.</div>{% endfor %}
    </section>

    <section class="card" style="margin-top:28px">
      <h2>Recommendations</h2>
      <ol class="recommendations">{% for recommendation in recommendations %}<li>{{ recommendation }}</li>{% endfor %}</ol>
    </section>
    <footer>Generated by CyberShield AI {{ report.version }} · Evidence should be reviewed by a qualified smart-contract security engineer.</footer>
  </main>
</body>
</html>
